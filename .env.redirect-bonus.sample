# Минимальное окружение отдельной публичной службы переходов redirect-bonus.
# Рабочий файл .env.redirect-bonus не добавляется в Git.

# Отдельный случайный секрет Django, не используемый другими контейнерами.
SECRET_KEY=
# Единственное публичное имя узла службы переходов.
ALLOWED_HOSTS=sagur.24vds.ru

# Действующая база SAGUR и отдельная роль только для чтения ссылки и записи перехода.
PG_NAME=
PG_USER=sagur_tracked_link
PG_PASSWORD=
PG_HOST=db
PG_PORT=5432
