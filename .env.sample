# =============================================================================
# Пример файла окружения для loyalty_service
# Скопируйте в .env и заполните реальные секреты/URL.
# Все комментарии даны на русском, чтобы упростить запуск и поддержку.
# =============================================================================

# -----------------------------------------------------------------------------
# Базовые настройки Django
# -----------------------------------------------------------------------------
# Режим разработки: True только локально, в проде всегда False.
DEBUG=False
# Секретный ключ Django (обязательно заменить на длинную случайную строку).
SECRET_KEY=replace-with-strong-random-secret
# Разрешённые хосты (через запятую, без пробелов в начале/конце).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,bonus.example.com
# Доверенные origin для CSRF (через запятую, обязательно со схемой).
CSRF_TRUSTED_ORIGINS=https://bonus.example.com,https://www.bonus.example.com
# Явно задаём settings-модуль (удобно для Docker и фоновых команд).
DJANGO_SETTINGS_MODULE=loyalty_viewer.settings
# Таймзона процесса внутри контейнера.
TZ=UTC

# -----------------------------------------------------------------------------
# Основная БД loyalty_service
# -----------------------------------------------------------------------------
PG_NAME=programm_loyalty
PG_USER=postgres
PG_PASSWORD=change_me
PG_HOST=db
PG_PORT=5432

# -----------------------------------------------------------------------------
# Внешняя БД веб-хук сервиса (откуда читаются записи webhook)
# Если используется тот же PostgreSQL-кластер, оставьте HOST=db.
# -----------------------------------------------------------------------------
WH_DB_NAME=webhook_service_db
WH_DB_USER=webhook_user
WH_DB_PASSWORD=change_me
WH_DB_HOST=db
WH_DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis для входящего webhook-worker и universal queue
# -----------------------------------------------------------------------------
# Входная очередь из внешнего webhook-сервиса.
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_QUEUE_NAME=webhook_queue
REDIS_DLQ_NAME=webhook_queue_dlq

# -----------------------------------------------------------------------------
# Доступ к внутреннему API webhook-сервиса (SAGUR)
# -----------------------------------------------------------------------------
SAGUR_BASE_URL=https://webhook.example.com
SAGUR_USERNAME=business_service
SAGUR_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Доступ к iiko API
# -----------------------------------------------------------------------------
IIKO_API_KEY=change_me
IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_ORGANIZATION_ID=change_me

# -----------------------------------------------------------------------------
# Доступ к iiko OLAP API (чековая аналитика / resto API)
# -----------------------------------------------------------------------------
# Базовый URL до /resto/api (без завершающего слеша).
IIKO_OLAP_BASE_URL=https://assorti-restorants-co.iiko.it/resto/api
# Логин и hash-пароль для POST /resto/api/auth (x-www-form-urlencoded).
IIKO_OLAP_LOGIN=change_me
IIKO_OLAP_PASS_HASH=change_me
# Таймауты и retries для OLAP-клиента.
IIKO_OLAP_AUTH_TIMEOUT_SECONDS=10
IIKO_OLAP_REQUEST_TIMEOUT_SECONDS=30
IIKO_OLAP_KEY_TTL_SECONDS=240
IIKO_OLAP_MAX_RETRIES=3
IIKO_OLAP_RETRY_BASE_SECONDS=1
# Размер порции orderNumber в одном OLAP-запросе.
IIKO_OLAP_PORTION_SIZE=200

# -----------------------------------------------------------------------------
# Live-мост webhook -> журнал синхронизации OLAP
# -----------------------------------------------------------------------------
# Включает постановку задач в olap_check_sync_journal из webhook notificationType=1.
# По умолчанию выключено для безопасного внедрения.
OLAP_BRIDGE_ENABLE_LIVE_WEBHOOK_ENQUEUE=False
# Разрешённые notificationType для постановки в журнал (CSV).
# Сейчас рабочий тип: 1 (изменение баланса/транзакции).
OLAP_BRIDGE_ALLOWED_NOTIFICATION_TYPES=1

# -----------------------------------------------------------------------------
# Balance webhook -> уведомления в боты
# -----------------------------------------------------------------------------
# Управляет постановкой задач уведомления об изменении баланса в universal queue.
# False: webhook обрабатывается, но задачи рассылки в боты не создаются.
# True: при balance-событии создаются задачи с высоким приоритетом.
BALANCE_WEBHOOK_NOTIFY_ENABLED=False

# -----------------------------------------------------------------------------
# Исторический прогон webhook -> olap_check_sync_journal (backfill)
# -----------------------------------------------------------------------------
# Глобальный флаг запуска backfill-команды в рабочем контуре.
OLAP_BACKFILL_ENABLE=False
# По умолчанию запускаем в dry-run (без записи в БД), пока не проверим статистику.
OLAP_BACKFILL_DRY_RUN=True
# Диапазон выборки webhook для исторического прогона.
OLAP_BACKFILL_DATE_FROM=2025-12-01T00:00:00Z
OLAP_BACKFILL_DATE_TO=
# Порции и паузы чтения webhook из внутреннего API.
OLAP_BACKFILL_PAGE_SIZE=100
OLAP_BACKFILL_MAX_PAGES_PER_CYCLE=5
OLAP_BACKFILL_SLEEP_BETWEEN_PAGES_SECONDS=1
OLAP_BACKFILL_SLEEP_BETWEEN_CYCLES_SECONDS=20
# Backpressure: пауза intake при большой очереди дозагрузки OLAP.
OLAP_BACKFILL_PAUSE_QUEUE_GT=5000
OLAP_BACKFILL_RESUME_QUEUE_LT=2000
# Таймауты HTTP-клиента backfill-команды.
OLAP_BACKFILL_AUTH_TIMEOUT_SECONDS=10
OLAP_BACKFILL_REQUEST_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Интеграция SAGUR <- vtelemax (каналы получателей для рассылки)
# -----------------------------------------------------------------------------
# Глобальный флаг включения синхронизации.
VTELEMAX_SYNC_ENABLED=False
# Базовый URL read-only API интеграции vtelemax (рекомендуется HTTPS).
VTELEMAX_SYNC_BASE_URL=https://sobalbot.24vds.ru
# HMAC-секрет для подписи запросов (должен совпадать с секретом на стороне vtelemax).
VTELEMAX_SYNC_HMAC_SECRET=change_me
# Требовать HTTPS для base_url (best practice безопасности).
# Для строго внутреннего доверенного контура можно временно выключить.
VTELEMAX_SYNC_REQUIRE_HTTPS=True
# Таймаут HTTP-клиента синхронизации (сек).
VTELEMAX_SYNC_HTTP_TIMEOUT_SECONDS=20
# Размер страницы API.
VTELEMAX_SYNC_DEFAULT_LIMIT=1000
VTELEMAX_SYNC_MAX_LIMIT=5000
# Разрешить автосоздание гостя в SAGUR, если phone из vtelemax не найден.
VTELEMAX_SYNC_CREATE_MISSING_GUESTS=False
# Явные коды BotProfile для платформ (если пусто — берётся первый активный по provider_type).
VTELEMAX_SYNC_BOT_CODE_TELEGRAM=
VTELEMAX_SYNC_BOT_CODE_MAX=
VTELEMAX_SYNC_BOT_CODE_VK=
# Плановый delta-синк через Django Q.
VTELEMAX_SYNC_SCHEDULE_ENABLED=False
VTELEMAX_SYNC_SCHEDULE_MINUTES=5

# -----------------------------------------------------------------------------
# Плановый OLAP-контур через Django Q (best practice: one-shot по расписанию)
# -----------------------------------------------------------------------------
# Важно: эти задачи выполняет сервис qcluster (task-bonus), а не отдельные вечные
# контейнеры с while/sleep.

# Дозагрузка OLAP: запуск раз в N минут, но только в рабочее окно времени.
# Автосинхронизация settings.Q_CLUSTER.schedule -> django_q_schedule при старте qcluster.
DJANGO_Q_SCHEDULE_AUTOSYNC_ON_QCLUSTER_START=True
# При True удаляются stale managed-строки, которых нет в settings map.
DJANGO_Q_SCHEDULE_AUTOSYNC_PRUNE_STALE=True
# Доп. managed-имена (CSV), если нужно расширить clean-up без правки кода.
DJANGO_Q_SCHEDULE_MANAGED_EXTRA_NAMES=

OLAP_SYNC_SCHEDULE_ENABLED=False
# Legacy-режим: запуск sync каждые N минут.
# Используется только если OLAP_SCHEDULE_USE_HOURLY_CRON_WAVES=False.
OLAP_SYNC_SCHEDULE_MINUTES=30
# Рекомендуемый режим (почасовые волны):
# cron запуска sync-шага в начале каждой волны.
# Текущая схема: :05 каждого часа с 11:00 до 00:00 (включительно 00:05).
OLAP_SYNC_SCHEDULE_CRON=5 11-23,0 * * *
# Рабочее окно выполнения sync в локальной таймзоне приложения.
# Если запуск пришел вне окна, задача корректно пропускается без ошибки.
# Поддерживается окно через полночь (пример: 11:00 -> 02:00).
OLAP_SYNC_WINDOW_START_LOCAL=12:00
OLAP_SYNC_WINDOW_END_LOCAL=01:00
# Ограничение нагрузки на один запуск sync-задачи:
# - CLAIM_LIMIT: сколько записей забираем из журнала за один проход;
# - PORTION_SIZE: размер порции запросов в OLAP API;
# - MAX_ATTEMPTS/RETRY_BASE_SECONDS: повторы при ошибках;
# - LOCK_TIMEOUT_SECONDS: время жизни блокировки строки в работе.
# Для более "мягкой" нагрузки уменьшают CLAIM_LIMIT и/или PORTION_SIZE.
OLAP_SYNC_SCHEDULE_CLAIM_LIMIT=100
OLAP_SYNC_SCHEDULE_PORTION_SIZE=50
OLAP_SYNC_SCHEDULE_MAX_ATTEMPTS=5
OLAP_SYNC_SCHEDULE_RETRY_BASE_SECONDS=120
OLAP_SYNC_SCHEDULE_LOCK_TIMEOUT_SECONDS=900

# Ночной пересчет витрин OLAP (one-shot).
OLAP_REBUILD_SCHEDULE_ENABLED=False
# Cron в формате Django Q: "минуты часы день_месяца месяц день_недели".
OLAP_REBUILD_SCHEDULE_CRON=30 2 * * *
OLAP_REBUILD_SCHEDULE_CONTINUE_ON_STEP_ERROR=True
OLAP_REBUILD_SCHEDULE_BATCH_SIZE=2000
OLAP_REBUILD_SCHEDULE_WINDOW_DAYS=7,14,30,60,180
OLAP_REBUILD_SCHEDULE_USE_TODAY_AS_OF_DATE=True
# Опционально: пересчет только по конкретному Department.Id (пусто = все заведения).
OLAP_REBUILD_SCHEDULE_DEPARTMENT_ID=

# Контрольный pull из OLAP (ночной анти-пропускной контур).
# Идея: раз в сутки (например, в 06:00) взять прямой срез OLAP за "хвост" N дней
# и поставить недостающие задачи в olap_check_sync_journal. Далее их доберет sync-worker.
OLAP_CONTROL_PULL_SCHEDULE_ENABLED=False
# Cron в формате Django Q: "минуты часы день_месяца месяц день_недели".
OLAP_CONTROL_PULL_SCHEDULE_CRON=0 6 * * *
# Сколько последних business_date включать в контрольный срез (обычно 2 дня).
OLAP_CONTROL_PULL_SCHEDULE_TAIL_DAYS=2
# False = писать в журнал, True = только считать статистику без записи.
OLAP_CONTROL_PULL_SCHEDULE_DRY_RUN=False
# Опционально: CSV Department.Id для ограничения контроля (пусто = все активные mapping).
OLAP_CONTROL_PULL_SCHEDULE_DEPARTMENT_IDS=
# Опционально: CSV-список телефонов, которые нужно игнорировать в control pull
# (например, номера агрегаторов/доставки, чтобы не создавать по ним гостей и не ставить OLAP-задачи).
# Формат: +79999999999,+73452393978
OLAP_CONTROL_PULL_PHONE_DENYLIST=

# Инкрементальный пересчет order_fact (шаг "факты чеков" каждые 15-30 минут).
OLAP_ORDER_FACT_SCHEDULE_ENABLED=False
# Legacy-режим: запуск пересчета order_fact каждые N минут.
# Используется только если OLAP_SCHEDULE_USE_HOURLY_CRON_WAVES=False.
OLAP_ORDER_FACT_SCHEDULE_MINUTES=30
# Рекомендуемый режим (почасовые волны):
# cron запуска шага order_fact после sync.
# Текущая схема: :15 каждого часа с 11:00 до 00:00.
OLAP_ORDER_FACT_SCHEDULE_CRON=15 11-23,0 * * *
# "Хвост" последних N дней для пересчета (обычно 2-3 дня).
OLAP_ORDER_FACT_SCHEDULE_TAIL_DAYS=3
# Лаг конца окна в днях: 0=включая сегодня, 1=до вчера включительно.
OLAP_ORDER_FACT_SCHEDULE_END_LAG_DAYS=0
OLAP_ORDER_FACT_SCHEDULE_BATCH_SIZE=2000
# Автосинхронизация применения купонов после обновления order_fact.
# True: в конце планового шага order_fact выполняется команда sync_coupon_redemptions
# по тому же диапазону business_date.
COUPON_REDEMPTION_SYNC_ENABLED=True
# Ограничение объёма обработки купонов за один проход (0 = без лимита).
COUPON_REDEMPTION_SYNC_LIMIT=0

# Инкрементальный пересчет daily_category_fact (шаг "дневные итоги" каждые 30-60 минут).
OLAP_DAILY_FACT_SCHEDULE_ENABLED=False
OLAP_DAILY_FACT_SCHEDULE_MINUTES=60
OLAP_DAILY_FACT_SCHEDULE_TAIL_DAYS=3
OLAP_DAILY_FACT_SCHEDULE_END_LAG_DAYS=0
OLAP_DAILY_FACT_SCHEDULE_BATCH_SIZE=2000

# Инкрементальный пересчет daily_order_fact (полные чеки) каждые 30-60 минут.
OLAP_DAILY_ORDER_FACT_SCHEDULE_ENABLED=False
# Legacy-режим: запуск пересчета daily_order_fact каждые N минут.
# Используется только если OLAP_SCHEDULE_USE_HOURLY_CRON_WAVES=False.
OLAP_DAILY_ORDER_FACT_SCHEDULE_MINUTES=60
# Рекомендуемый режим (почасовые волны):
# cron запуска шага daily_order_fact после order_fact.
# Текущая схема: :25 каждого часа с 11:00 до 00:00.
OLAP_DAILY_ORDER_FACT_SCHEDULE_CRON=25 11-23,0 * * *
OLAP_DAILY_ORDER_FACT_SCHEDULE_TAIL_DAYS=3
OLAP_DAILY_ORDER_FACT_SCHEDULE_END_LAG_DAYS=0
OLAP_DAILY_ORDER_FACT_SCHEDULE_BATCH_SIZE=2000
# Опционально: ограничить пересчет одним Department.Id.
OLAP_DAILY_ORDER_FACT_SCHEDULE_DEPARTMENT_ID=

# Инкрементальный пересчет order_focus_fact (order-level мост категорий) каждые 30-60 минут.
OLAP_ORDER_FOCUS_FACT_SCHEDULE_ENABLED=False
OLAP_ORDER_FOCUS_FACT_SCHEDULE_MINUTES=60
OLAP_ORDER_FOCUS_FACT_SCHEDULE_TAIL_DAYS=3
OLAP_ORDER_FOCUS_FACT_SCHEDULE_END_LAG_DAYS=0
OLAP_ORDER_FOCUS_FACT_SCHEDULE_BATCH_SIZE=2000
# Опционально: ограничить пересчет одним Department.Id.
OLAP_ORDER_FOCUS_FACT_SCHEDULE_DEPARTMENT_ID=

# Пересчет оконных метрик (7/14/30/60/180) каждый час.
OLAP_WINDOW_METRICS_SCHEDULE_ENABLED=False
# Legacy-режим: запуск пересчета window_metrics каждые N минут.
# Используется только если OLAP_SCHEDULE_USE_HOURLY_CRON_WAVES=False.
OLAP_WINDOW_METRICS_SCHEDULE_MINUTES=60
# Рекомендуемый режим (почасовые волны):
# cron запуска финального шага window_metrics.
# Текущая схема: :35 каждого часа с 11:00 до 00:00.
OLAP_WINDOW_METRICS_SCHEDULE_CRON=35 11-23,0 * * *
# Лаг as_of_date в днях: 0=считать на сегодня, 1=на вчера.
OLAP_WINDOW_METRICS_SCHEDULE_AS_OF_LAG_DAYS=0
OLAP_WINDOW_METRICS_SCHEDULE_BATCH_SIZE=2000
OLAP_WINDOW_METRICS_SCHEDULE_WINDOW_DAYS=7,14,30,60,180
# Опционально: ограничить пересчет одним Department.Id.
OLAP_WINDOW_METRICS_SCHEDULE_DEPARTMENT_ID=

# Переключатель режима category-window метрик в guests/workbench.
WORKBENCH_CATEGORY_WINDOW_METRICS_V2=False

# Пересчёт category-window метрик (F21) каждый час.
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_ENABLED=False
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_MINUTES=60
# Лаг as_of_date в днях: 0=считать на сегодня, 1=на вчера.
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_AS_OF_LAG_DAYS=0
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_BATCH_SIZE=2000
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_WINDOW_DAYS=7,14,30,60,180
# Опционально: ограничить пересчёт одним Department.Id.
OLAP_WINDOW_CATEGORY_METRICS_SCHEDULE_DEPARTMENT_ID=

# Единый режим последовательных почасовых волн OLAP-витрин.
# True:
#   задачи sync/order_fact/daily_order_fact/window_metrics берут cron-расписания *_SCHEDULE_CRON
#   и идут в стабильной последовательности "волной" внутри часа.
# False:
#   используется старый интервальный режим *_SCHEDULE_MINUTES (возможен дрейф по минутам).
OLAP_SCHEDULE_USE_HOURLY_CRON_WAVES=True

# -----------------------------------------------------------------------------
# Автосоздание суперпользователя (команда createsu)
# -----------------------------------------------------------------------------
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Universal Queue: общие настройки
# -----------------------------------------------------------------------------
# Можно оставить пустым, тогда возьмётся REDIS_QUEUE_URL.
UNIVERSAL_QUEUE_REDIS_URL=redis://redis:6379/1
# Пространство ключей в Redis, чтобы не конфликтовать с другими очередями.
UNIVERSAL_QUEUE_NAMESPACE=uq:v1

# Размер пачки диспетчеризации задач из БД в Redis lane-очереди.
UNIVERSAL_DISPATCH_BATCH_SIZE=200
# Пауза между итерациями диспетчера при пустой выборке.
UNIVERSAL_DISPATCH_SLEEP_SECONDS=2

# -----------------------------------------------------------------------------
# Universal Queue: массовые рассылки
# -----------------------------------------------------------------------------
# Режим получателей и приоритет теперь задаются в карточке рассылки (модель Mailing):
# - target_mode: primary_only|all_bots
# - queue_priority: high|normal|bulk
# Воркер рассылки всегда работает в dispatch-only режиме через DispatchTask.

# -----------------------------------------------------------------------------
# Async provider-worker: цикл чтения/повторов
# -----------------------------------------------------------------------------
UNIVERSAL_PROVIDER_BLOCK_TIMEOUT_SECONDS=2
UNIVERSAL_PROVIDER_IDLE_SLEEP_SECONDS=0.2
UNIVERSAL_PROVIDER_RETRY_BASE_SECONDS=3
UNIVERSAL_PROVIDER_RETRY_MAX_SECONDS=300

# -----------------------------------------------------------------------------
# Fair-policy (чтобы bulk не голодал при постоянном high)
# -----------------------------------------------------------------------------
UNIVERSAL_FAIR_HIGH=10
UNIVERSAL_FAIR_NORMAL=3
UNIVERSAL_FAIR_BULK=1

# -----------------------------------------------------------------------------
# Централизованный rate limit по провайдерам (сообщений/сек)
# -----------------------------------------------------------------------------
UNIVERSAL_RATE_LIMIT_TELEGRAM_PER_SECOND=28
UNIVERSAL_RATE_LIMIT_MAX_PER_SECOND=20
UNIVERSAL_RATE_LIMIT_VK_PER_SECOND=20

# -----------------------------------------------------------------------------
# HTTP-клиенты провайдеров
# -----------------------------------------------------------------------------
UNIVERSAL_PROVIDER_HTTP_TIMEOUT=20
TELEGRAM_API_BASE_URL=https://api.telegram.org
MAX_API_BASE_URL=https://platform-api.max.ru
# Префикс авторизации MAX API, например "Bearer". Можно оставить пустым.
MAX_API_AUTH_PREFIX=Bearer
VK_API_BASE_URL=https://api.vk.com/method
VK_API_VERSION=5.199

# -----------------------------------------------------------------------------
# Universal Queue monitor/recovery
# -----------------------------------------------------------------------------
UNIVERSAL_MONITOR_INTERVAL_SECONDS=60
UNIVERSAL_STALE_QUEUED_SECONDS=180
UNIVERSAL_STALE_IN_PROGRESS_SECONDS=600

# -----------------------------------------------------------------------------
# Legacy webhook-worker (входная очередь)
# -----------------------------------------------------------------------------
# Максимум повторов для неуспешной обработки входящего webhook.
MAX_RETRIES=3
# Интервал логирования активности воркера (сек).
ACTIVITY_LOG_INTERVAL=300
# Таймаут BLPOP входящей очереди (сек).
BLPOP_TIMEOUT=2

# -----------------------------------------------------------------------------
# Токены провайдеров (fallback)
# Используются, если в BotProfile не заполнен secret_ref/ключ.
# -----------------------------------------------------------------------------
UNIVERSAL_QUEUE_TELEGRAM_FALLBACK_TOKEN=123456:example_telegram_token
UNIVERSAL_QUEUE_MAX_FALLBACK_TOKEN=example_max_token
UNIVERSAL_QUEUE_VK_FALLBACK_TOKEN=example_vk_group_token

# -----------------------------------------------------------------------------
# Пример ключей для BotProfile.secret_ref
# Если в записи бота secret_ref="BOT_TOKEN_TELEGRAM_MAIN", воркер возьмёт
# значение из переменной BOT_TOKEN_TELEGRAM_MAIN.
# -----------------------------------------------------------------------------
BOT_TOKEN_TELEGRAM_MAIN=123456:telegram_main_token
BOT_TOKEN_MAX_MAIN=max_main_token
BOT_TOKEN_VK_MAIN=vk_main_group_token
