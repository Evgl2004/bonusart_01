# =============================================================================
# Пример файла окружения для loyalty_service
# Скопируйте в .env и заполните реальные секреты/URL.
# Все комментарии даны на русском, чтобы упростить запуск и поддержку.
# =============================================================================

# -----------------------------------------------------------------------------
# Базовые настройки Django
# -----------------------------------------------------------------------------
# Режим разработки: True только локально, в проде всегда False.
DEBUG=False
# Секретный ключ Django (обязательно заменить на длинную случайную строку).
SECRET_KEY=replace-with-strong-random-secret
# Разрешённые хосты (через запятую, без пробелов в начале/конце).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,bonus.example.com
# Доверенные origin для CSRF (через запятую, обязательно со схемой).
CSRF_TRUSTED_ORIGINS=https://bonus.example.com,https://www.bonus.example.com
# Явно задаём settings-модуль (удобно для Docker и фоновых команд).
DJANGO_SETTINGS_MODULE=loyalty_viewer.settings
# Таймзона процесса внутри контейнера.
TZ=UTC

# -----------------------------------------------------------------------------
# Основная БД loyalty_service
# -----------------------------------------------------------------------------
PG_NAME=programm_loyalty
PG_USER=postgres
PG_PASSWORD=change_me
PG_HOST=db
PG_PORT=5432

# -----------------------------------------------------------------------------
# Внешняя БД веб-хук сервиса (откуда читаются записи webhook)
# Если используется тот же PostgreSQL-кластер, оставьте HOST=db.
# -----------------------------------------------------------------------------
WH_DB_NAME=webhook_service_db
WH_DB_USER=webhook_user
WH_DB_PASSWORD=change_me
WH_DB_HOST=db
WH_DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis для входящего webhook-worker и universal queue
# -----------------------------------------------------------------------------
# Входная очередь из внешнего webhook-сервиса.
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_QUEUE_NAME=webhook_queue
REDIS_DLQ_NAME=webhook_queue_dlq

# -----------------------------------------------------------------------------
# Доступ к внутреннему API webhook-сервиса (SAGUR)
# -----------------------------------------------------------------------------
SAGUR_BASE_URL=https://webhook.example.com
SAGUR_USERNAME=business_service
SAGUR_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Доступ к iiko API
# -----------------------------------------------------------------------------
IIKO_API_KEY=change_me
IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_ORGANIZATION_ID=change_me

# -----------------------------------------------------------------------------
# Доступ к iiko OLAP API (чековая аналитика / resto API)
# -----------------------------------------------------------------------------
# Базовый URL до /resto/api (без завершающего слеша).
IIKO_OLAP_BASE_URL=https://assorti-restorants-co.iiko.it/resto/api
# Логин и hash-пароль для POST /resto/api/auth (x-www-form-urlencoded).
IIKO_OLAP_LOGIN=change_me
IIKO_OLAP_PASS_HASH=change_me
# Таймауты и retries для OLAP-клиента.
IIKO_OLAP_AUTH_TIMEOUT_SECONDS=10
IIKO_OLAP_REQUEST_TIMEOUT_SECONDS=30
IIKO_OLAP_KEY_TTL_SECONDS=240
IIKO_OLAP_MAX_RETRIES=3
IIKO_OLAP_RETRY_BASE_SECONDS=1
# Размер порции orderNumber в одном OLAP-запросе.
IIKO_OLAP_PORTION_SIZE=200

# -----------------------------------------------------------------------------
# Live-мост webhook -> журнал синхронизации OLAP
# -----------------------------------------------------------------------------
# Включает постановку задач в olap_check_sync_journal из webhook notificationType=1.
# По умолчанию выключено для безопасного внедрения.
OLAP_BRIDGE_ENABLE_LIVE_WEBHOOK_ENQUEUE=False
# Разрешённые notificationType для постановки в журнал (CSV).
# Сейчас рабочий тип: 1 (изменение баланса/транзакции).
OLAP_BRIDGE_ALLOWED_NOTIFICATION_TYPES=1

# -----------------------------------------------------------------------------
# Исторический прогон webhook -> olap_check_sync_journal (backfill)
# -----------------------------------------------------------------------------
# Глобальный флаг запуска backfill-команды в рабочем контуре.
OLAP_BACKFILL_ENABLE=False
# По умолчанию запускаем в dry-run (без записи в БД), пока не проверим статистику.
OLAP_BACKFILL_DRY_RUN=True
# Диапазон выборки webhook для исторического прогона.
OLAP_BACKFILL_DATE_FROM=2025-12-01T00:00:00Z
OLAP_BACKFILL_DATE_TO=
# Порции и паузы чтения webhook из внутреннего API.
OLAP_BACKFILL_PAGE_SIZE=100
OLAP_BACKFILL_MAX_PAGES_PER_CYCLE=5
OLAP_BACKFILL_SLEEP_BETWEEN_PAGES_SECONDS=1
OLAP_BACKFILL_SLEEP_BETWEEN_CYCLES_SECONDS=20
# Backpressure: пауза intake при большой очереди дозагрузки OLAP.
OLAP_BACKFILL_PAUSE_QUEUE_GT=5000
OLAP_BACKFILL_RESUME_QUEUE_LT=2000
# Таймауты HTTP-клиента backfill-команды.
OLAP_BACKFILL_AUTH_TIMEOUT_SECONDS=10
OLAP_BACKFILL_REQUEST_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Автосоздание суперпользователя (команда createsu)
# -----------------------------------------------------------------------------
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Universal Queue: общие настройки
# -----------------------------------------------------------------------------
# Можно оставить пустым, тогда возьмётся REDIS_QUEUE_URL.
UNIVERSAL_QUEUE_REDIS_URL=redis://redis:6379/1
# Пространство ключей в Redis, чтобы не конфликтовать с другими очередями.
UNIVERSAL_QUEUE_NAMESPACE=uq:v1

# Размер пачки диспетчеризации задач из БД в Redis lane-очереди.
UNIVERSAL_DISPATCH_BATCH_SIZE=200
# Пауза между итерациями диспетчера при пустой выборке.
UNIVERSAL_DISPATCH_SLEEP_SECONDS=2

# -----------------------------------------------------------------------------
# Universal Queue: массовые рассылки
# -----------------------------------------------------------------------------
# Режим получателей и приоритет теперь задаются в карточке рассылки (модель Mailing):
# - target_mode: primary_only|all_bots
# - queue_priority: high|normal|bulk
# Воркер рассылки всегда работает в dispatch-only режиме через DispatchTask.

# -----------------------------------------------------------------------------
# Async provider-worker: цикл чтения/повторов
# -----------------------------------------------------------------------------
UNIVERSAL_PROVIDER_BLOCK_TIMEOUT_SECONDS=2
UNIVERSAL_PROVIDER_IDLE_SLEEP_SECONDS=0.2
UNIVERSAL_PROVIDER_RETRY_BASE_SECONDS=3
UNIVERSAL_PROVIDER_RETRY_MAX_SECONDS=300

# -----------------------------------------------------------------------------
# Fair-policy (чтобы bulk не голодал при постоянном high)
# -----------------------------------------------------------------------------
UNIVERSAL_FAIR_HIGH=10
UNIVERSAL_FAIR_NORMAL=3
UNIVERSAL_FAIR_BULK=1

# -----------------------------------------------------------------------------
# Централизованный rate limit по провайдерам (сообщений/сек)
# -----------------------------------------------------------------------------
UNIVERSAL_RATE_LIMIT_TELEGRAM_PER_SECOND=28
UNIVERSAL_RATE_LIMIT_MAX_PER_SECOND=20
UNIVERSAL_RATE_LIMIT_VK_PER_SECOND=20

# -----------------------------------------------------------------------------
# HTTP-клиенты провайдеров
# -----------------------------------------------------------------------------
UNIVERSAL_PROVIDER_HTTP_TIMEOUT=20
TELEGRAM_API_BASE_URL=https://api.telegram.org
MAX_API_BASE_URL=https://platform-api.max.ru
# Префикс авторизации MAX API, например "Bearer". Можно оставить пустым.
MAX_API_AUTH_PREFIX=Bearer
VK_API_BASE_URL=https://api.vk.com/method
VK_API_VERSION=5.199

# -----------------------------------------------------------------------------
# Universal Queue monitor/recovery
# -----------------------------------------------------------------------------
UNIVERSAL_MONITOR_INTERVAL_SECONDS=60
UNIVERSAL_STALE_QUEUED_SECONDS=180
UNIVERSAL_STALE_IN_PROGRESS_SECONDS=600

# -----------------------------------------------------------------------------
# Legacy webhook-worker (входная очередь)
# -----------------------------------------------------------------------------
# Максимум повторов для неуспешной обработки входящего webhook.
MAX_RETRIES=3
# Интервал логирования активности воркера (сек).
ACTIVITY_LOG_INTERVAL=300
# Таймаут BLPOP входящей очереди (сек).
BLPOP_TIMEOUT=2

# -----------------------------------------------------------------------------
# Токены провайдеров (fallback)
# Используются, если в BotProfile не заполнен secret_ref/ключ.
# -----------------------------------------------------------------------------
UNIVERSAL_QUEUE_TELEGRAM_FALLBACK_TOKEN=123456:example_telegram_token
UNIVERSAL_QUEUE_MAX_FALLBACK_TOKEN=example_max_token
UNIVERSAL_QUEUE_VK_FALLBACK_TOKEN=example_vk_group_token

# -----------------------------------------------------------------------------
# Пример ключей для BotProfile.secret_ref
# Если в записи бота secret_ref="BOT_TOKEN_TELEGRAM_MAIN", воркер возьмёт
# значение из переменной BOT_TOKEN_TELEGRAM_MAIN.
# -----------------------------------------------------------------------------
BOT_TOKEN_TELEGRAM_MAIN=123456:telegram_main_token
BOT_TOKEN_MAX_MAIN=max_main_token
BOT_TOKEN_VK_MAIN=vk_main_group_token
